{
	"name": "claude-lookout-workspace",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"check": "npm run typecheck && npm run lint && npm run test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
